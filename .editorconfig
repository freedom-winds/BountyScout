# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org/

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.json]
trim_trailing_whitespace = false

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

[package.json]
trim_trailing_whitespace = false

[package-lock.json]
indent_size = 2

[Dockerfile]
indent_style = space
indent_size = 2
