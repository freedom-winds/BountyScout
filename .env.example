# GitHub token (required for rate-limited access)
GITHUB_TOKEN=your_github_token_here

# Discord webhook URL for notifications
DISCORD_WEBHOOK_URL=

# Telegram bot token and chat ID for notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated list of repositories to scan
BOUNTY_REPOSITORIES=MyZubster-Ecosystem/myzubster,Nudge-Pay/nudge-server,Perenna-Labs/perenna-contracts,Sottara-Labs/sottara,klineodyssey/kline-odyssey

# Scan interval in seconds (default: 3600)
SCAN_INTERVAL_SECONDS=3600

# Output directory
OUTPUT_DIR=./output
